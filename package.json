{
  "name": "@lgriffin/esi.ts",
  "version": "10.2.3",
  "description": "This is a TypeScript Implementation for the EVE Online API offered through ESI",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "type": "commonjs",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./schemas": {
      "import": {
        "types": "./dist/schemas/index.d.mts",
        "default": "./dist/schemas/index.mjs"
      },
      "require": {
        "types": "./dist/schemas/index.d.ts",
        "default": "./dist/schemas/index.js"
      }
    },
    "./errors": {
      "import": {
        "types": "./dist/errors.d.mts",
        "default": "./dist/errors.mjs"
      },
      "require": {
        "types": "./dist/errors.d.ts",
        "default": "./dist/errors.js"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing/index.d.mts",
        "default": "./dist/testing/index.mjs"
      },
      "require": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client/index.d.mts",
        "default": "./dist/client/index.mjs"
      },
      "require": {
        "types": "./dist/client/index.d.ts",
        "default": "./dist/client/index.js"
      }
    },
    "./sde": {
      "import": {
        "types": "./dist/sde/index.d.mts",
        "default": "./dist/sde/index.mjs"
      },
      "require": {
        "types": "./dist/sde/index.d.ts",
        "default": "./dist/sde/index.js"
      }
    },
    "./sde/memory": {
      "import": {
        "types": "./dist/sde/memory.d.mts",
        "default": "./dist/sde/memory.mjs"
      },
      "require": {
        "types": "./dist/sde/memory.d.ts",
        "default": "./dist/sde/memory.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly && node scripts/package/esm-declarations.cjs",
    "typecheck": "tsc --noEmit",
    "typecheck:examples": "tsc -p tsconfig.examples.json",
    "typecheck:isolated": "ts-node scripts/package/isolated-declarations.ts",
    "examples:nightly": "ts-node scripts/docs/examples-nightly.ts",
    "help": "ts-node scripts/quality/npm-help.ts",
    "start": "ts-node examples/character-profile.ts",
    "example": "ts-node examples/character-profile.ts",
    "example:status": "ts-node examples/status.ts",
    "example:multi-character": "ts-node examples/multi-character.ts",
    "example:public-vs-authenticated": "ts-node examples/public-vs-authenticated.ts",
    "example:character": "ts-node examples/character-lookup.ts",
    "example:universe": "ts-node examples/universe-info.ts",
    "example:market": "ts-node examples/market-prices.ts",
    "example:alliance": "ts-node examples/alliance-info.ts",
    "example:route": "ts-node examples/route-planner.ts",
    "example:wars": "ts-node examples/wars.ts",
