    "bdd:etag-caching": "jest --config config/jest/unit.config.cjs --testPathPatterns=step-definitions/core/etag-caching",
    "bdd:factions": "jest --config config/jest/unit.config.cjs --testPathPatterns=step-definitions/core/factions",
    "bdd:fittings": "jest --config config/jest/unit.config.cjs --testPathPatterns=step-definitions/core/fittings",
    "bdd:fleets": "jest --config config/jest/unit.config.cjs --testPathPatterns=step-definitions/core/fleets",
    "bdd:freelance": "jest --config config/jest/unit.config.cjs --testPathPatterns=step-definitions/core/freelance",
    "bdd:incursions": "jest --config config/jest/unit.config.cjs --testPathPatterns=step-definitions/core/incursions",
    "bdd:industry": "jest --config config/jest/unit.config.cjs --testPathPatterns=step-definitions/core/industry",
    "bdd:insurance": "jest --config config/jest/unit.config.cjs --testPathPatterns=specs/core/0018-insurance",
    "bdd:killmails": "jest --config config/jest/unit.config.cjs --testPathPatterns=specs/core/0019-killmails",
    "bdd:location": "jest --config config/jest/unit.config.cjs --testPathPatterns=step-definitions/core/location",
    "bdd:loyalty": "jest --config config/jest/unit.config.cjs --testPathPatterns=step-definitions/core/loyalty",
    "bdd:mail": "jest --config config/jest/unit.config.cjs --testPathPatterns=specs/core/0022-mail",
    "bdd:market": "jest --config config/jest/unit.config.cjs --testPathPatterns=specs/core/0023-market",
    "bdd:meta": "jest --config config/jest/unit.config.cjs --testPathPatterns=specs/core/0025-meta",
    "bdd:pi": "jest --config config/jest/unit.config.cjs --testPathPatterns=step-definitions/core/pi",
    "bdd:route": "jest --config config/jest/unit.config.cjs --testPathPatterns=specs/core/0029-route",
    "bdd:search": "jest --config config/jest/unit.config.cjs --testPathPatterns=step-definitions/core/search",
    "bdd:skills": "jest --config config/jest/unit.config.cjs --testPathPatterns=step-definitions/core/skills",
    "bdd:skyhooks": "jest --config config/jest/unit.config.cjs --testPathPatterns=step-definitions/core/skyhooks",
    "bdd:sovereignty": "jest --config config/jest/unit.config.cjs --testPathPatterns=step-definitions/core/sovereignty",
    "bdd:mercenary": "jest --config config/jest/unit.config.cjs --testPathPatterns=step-definitions/core/mercenary",
    "bdd:military-campaigns": "jest --config config/jest/unit.config.cjs --testPathPatterns=step-definitions/core/military-campaigns",
    "bdd:access-lists": "jest --config config/jest/unit.config.cjs --testPathPatterns=specs/core/0039-access-lists",
    "bdd:sde": "jest --config config/jest/unit.config.cjs --testPathPatterns=specs/sde",
    "bdd:status": "jest --config config/jest/unit.config.cjs --testPathPatterns=step-definitions/core/status",
    "bdd:resilience": "jest --config config/jest/unit.config.cjs --testPathPatterns=step-definitions/core/resilience",
    "bdd:ui": "jest --config config/jest/unit.config.cjs --testPathPatterns=step-definitions/core/ui",
    "bdd:universe": "jest --config config/jest/unit.config.cjs --testPathPatterns=specs/core/0036-universe",
    "bdd:wallet": "jest --config config/jest/unit.config.cjs --testPathPatterns=specs/core/0037-wallet",
    "bdd:wars": "jest --config config/jest/unit.config.cjs --testPathPatterns=specs/core/0038-wars",
    "bdd:token-management": "jest --config config/jest/unit.config.cjs --testPathPatterns=step-definitions/core/token-management",
    "bdd:integration": "jest --config config/jest/unit.config.cjs --testPathPatterns=step-definitions/integration",
    "bdd:performance": "jest --config config/jest/unit.config.cjs --testPathPatterns=step-definitions/performance",
    "coverage": "jest --config config/jest/unit.config.cjs --coverage",
    "test:integration": "jest --config config/jest/integration.config.cjs",
    "test:integration:live": "jest --config config/jest/integration.live.config.cjs",
    "test:integration:gated": "node --env-file=.env -e \"require('child_process').execSync('npx jest --config config/jest/integration.config.cjs --testPathPatterns=gated-auth',{stdio:'inherit',env:Object.assign({},process.env,{ESI_GATED_TESTS:'true'})})\"",
    "test:all": "npm run test && npm run bdd && npm run test:integration && npm run fuzz && npm run test:types",
    "contract": "jest --config config/jest/contract.config.cjs",
    "contract:live": "jest --config config/jest/contract.live.config.cjs",
    "contract:snapshot": "ts-node scripts/spec/snapshot-openapi.ts",
    "contract:record": "ts-node tests/contract/record.ts",
    "contract:replay": "jest --config config/jest/contract.replay.config.cjs",
    "contract:shape-diff": "ts-node tests/contract/shape-diff.ts",
    "contract:diff": "docker run --rm -v ./tests/contract/snapshots:/specs tufin/oasdiff breaking /specs/esi-openapi.snapshot.json https://esi.evetech.net/meta/openapi.json",
    "benchmark": "ts-node scripts/bench/bench-ab.ts --head .",
    "bench:ab": "ts-node scripts/bench/bench-ab.ts",
    "bench:compare": "ts-node scripts/bench/bench-compare.ts",
    "bench:trend": "ts-node scripts/bench/bench-trend.ts",
    "soak": "node --expose-gc -r ts-node/register/transpile-only scripts/bench/soak.ts",
    "fuzz": "jest --config config/jest/fuzz.config.cjs",
    "fuzz:properties": "jest --config config/jest/fuzz.config.cjs --testPathPatterns property.test sde-schema-fuzz.test",
    "fuzz:api": "bash scripts/spec/run-schemathesis.sh",
    "faults": "jest --config config/jest/faults.config.cjs",
    "faults:nightly": "jest --config config/jest/faults.nightly.config.cjs",
    "mock:esi": "prism mock https://esi.evetech.net/meta/openapi.json -p 4010",
    "test:types": "tsd --files 'tests/typetests/*.test-d.ts'",
    "test:export-coverage": "ts-node scripts/package/export-coverage.ts",
    "test:type-mutation": "ts-node scripts/mutation/type-mutation.ts",
    "test:consumer": "ts-node scripts/quality/consumer-contract.ts",
    "test:docs-examples": "ts-node scripts/docs/doc-examples.ts",
    "generate:types": "ts-node scripts/spec/generate-esi-types.ts",
    "generate:okf": "ts-node scripts/docs/generate-okf.ts",
    "generate:endpoints": "ts-node scripts/spec/generate-endpoint-scaffold.ts",
    "generate:all": "npm run generate:types && npm run generate:okf && npm run contract:snapshot && npm run schema:drift && npm run validate:esi",
    "knip": "knip",
    "validate:esi": "ts-node scripts/spec/validate-esi-endpoints.ts",
    "validate:esi:vendored": "ts-node scripts/spec/validate-esi-endpoints.ts --spec-file=tests/contract/snapshots/esi-openapi.snapshot.json",
    "validate:auth-scopes": "ts-node scripts/spec/validate-auth-scopes.ts",
    "validate:spec": "redocly lint",
    "validate": "npm run lint && npm run format:check && npm run build && npm run coverage && npm run knip",
    "release:canary": "ts-node scripts/release/release-canary.ts",
    "release:sbom": "ts-node scripts/release/release-sbom.ts",
    "release:dedupe-changelog": "ts-node scripts/release/changelog-dedupe.ts",
    "validate:versions": "ts-node --transpile-only scripts/package/validate-versions.ts",
    "spec:generate": "ts-node scripts/spec/spec-generate.ts",
    "spec:generate:check": "ts-node scripts/spec/spec-generate.ts --check",
    "spec:coverage": "ts-node scripts/spec/spec-coverage.ts",
    "spec:coverage:sde": "ts-node scripts/sde/sde-spec-coverage.ts",
    "spec:coverage:sde:ci": "ts-node scripts/sde/sde-spec-coverage.ts --ci",
    "spec:response-schemas": "ts-node scripts/spec/spec-response-schemas.ts",
    "spec:audit": "ts-node scripts/spec/spec-audit.ts",
    "charter:audit": "ts-node scripts/quality/charter-audit.ts",
    "spec:audit:verbose": "ts-node scripts/spec/spec-audit.ts --verbose",
    "bdd:report": "ts-node scripts/quality/bdd-report.ts",
    "ears": "ts-node scripts/quality/ears.ts",
    "validate:spec-consistency": "ts-node scripts/spec/rule-schema-check.ts",
    "check:local": "ts-node scripts/quality/verify-local.ts",
    "check:local:fast": "ts-node scripts/quality/verify-local.ts --fast",
    "check:local:all": "ts-node scripts/quality/verify-local.ts --all",
    "check:all": "npm run lint && npm run format:check && npm run build && npm run coverage && npm run knip && npm run validate:esi && npm run validate:spec && npm run validate:versions && npm run spec:audit && npm run charter:audit && npm run validate:spec-consistency && npm run spec:coverage:sde:ci",
    "docs": "typedoc --options typedoc.json",
    "docs:watch": "typedoc --options typedoc.json --watch",
    "docs:serve": "npx http-server docs-site/public/api -p 8080 -o",
    "docs:sync": "ts-node scripts/docs/sync-docs.ts",
    "docs:metrics": "ts-node --transpile-only scripts/docs/doc-metrics.ts",
    "docs:site": "npm run docs && npm run docs:sync && npm --prefix docs-site run build",
    "docs:site:dev": "npm run docs:sync && npm --prefix docs-site run dev",
    "docs:site:preview": "npm --prefix docs-site run preview",
    "clean": "rm -rf dist coverage && npm run clean:docs",
    "clean:docs": "rm -rf docs-site/public/api docs-site/guide docs-site/examples docs-site/.vitepress/dist docs-site/.vitepress/sidebar.generated.json",
    "prepare": "husky && npm run build",
    "health-check": "ts-node -e \"import('./src/EsiClient').then(({EsiClient}) => { const c = new EsiClient(); return c.status.getStatus().then(console.log).finally(() => c.shutdown()); })\"",
    "mutation": "stryker run config/mutation/stryker.config.mjs",
    "mutation:report": "stryker run config/mutation/stryker.config.mjs --reporters html,clear-text",
    "mutation:bdd": "stryker run config/mutation/stryker.bdd.config.mjs",
    "mutation:bdd:merge": "ts-node scripts/mutation/mutation-merge.ts",
    "mutation:unit:merge": "ts-node scripts/mutation/mutation-merge.ts --shards config/mutation/unit-shards.json --shard-dir reports/mutation/shards --out reports/mutation/mutation.json",
    "mutation:bdd:ratchet": "ts-node scripts/mutation/mutation-ratchet.ts",
    "mutation:ratchet": "ts-node scripts/mutation/mutation-ratchet.ts --suite unit",
    "mutation:pr": "ts-node scripts/mutation/mutation-pr.ts",
    "mutation:pr:shard": "ts-node scripts/mutation/mutation-pr.ts --baseline-shard",
    "mutation:pr:gate": "ts-node scripts/mutation/mutation-pr-gate.ts",
    "mutation:fixture": "ts-node scripts/mutation/mutation-fixture.ts",
    "api-report": "api-extractor run --local --verbose",
    "api-report:check": "api-extractor run --verbose",
    "api-report:semver": "ts-node scripts/package/api-semver-gate.ts",
    "schema:drift": "ts-node scripts/spec/generate-schema-drift-report.ts",
    "schema:drift:ci": "ts-node scripts/spec/generate-schema-drift-report.ts --ci",
    "audit:check": "ts-node scripts/quality/audit-check.ts --check",
    "audit:diff": "ts-node scripts/quality/audit-check.ts --diff"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "tests/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
