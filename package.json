    "example:industry": "ts-node examples/industry.ts",
    "example:incursions": "ts-node examples/incursions.ts",
    "example:dogma": "ts-node examples/dogma.ts",
    "example:wallet": "ts-node examples/wallet-overview.ts",
    "example:skills": "ts-node examples/skills-overview.ts",
    "example:assets": "ts-node examples/assets-inventory.ts",
    "example:contracts": "ts-node examples/contracts-browser.ts",
    "example:killmails": "ts-node examples/killmails.ts",
    "example:fleet": "ts-node examples/fleet-operations.ts",
    "example:mail": "ts-node examples/mail-inbox.ts",
    "example:location": "ts-node examples/location-tracker.ts",
    "example:fittings": "ts-node examples/fittings-clones.ts",
    "example:contacts": "ts-node examples/contacts.ts",
    "example:rate-limiting": "ts-node examples/rate-limiting.ts",
    "example:cursor-pagination": "ts-node examples/cursor-pagination.ts",
    "example:token-refresh": "ts-node examples/token-refresh.ts",
    "example:token-manager": "ts-node examples/token-manager.ts",
    "example:retry-timeout-metadata": "ts-node examples/retry-timeout-metadata.ts",
    "example:streaming": "ts-node examples/streaming-pagination.ts",
    "example:character-details": "ts-node examples/character-details.ts",
    "example:corporation-details": "ts-node examples/corporation-details.ts",
    "example:calendar-search": "ts-node examples/calendar-search.ts",
    "example:loyalty-pi": "ts-node examples/loyalty-pi.ts",
    "example:faction-details": "ts-node examples/faction-warfare-details.ts",
    "example:industry-mining": "ts-node examples/industry-mining.ts",
    "example:market-orders": "ts-node examples/market-orders.ts",
    "example:universe-encyclopedia": "ts-node examples/universe-encyclopedia.ts",
    "example:corp-contracts-wallet": "ts-node examples/corp-contracts-wallet.ts",
    "example:dogma-meta-sov": "ts-node examples/dogma-meta-sov.ts",
    "example:universe-posts": "ts-node examples/universe-post-helpers.ts",
    "example:corporation-projects": "ts-node examples/corporation-projects.ts",
    "example:freelance-jobs": "ts-node examples/freelance-jobs.ts",
    "example:military-campaigns": "ts-node examples/military-campaigns.ts",
    "example:meta": "ts-node examples/meta.ts",
    "example:public-contracts": "ts-node examples/public-contracts.ts",
    "example:corporation-history": "ts-node examples/corporation-history.ts",
    "example:remaining-coverage": "ts-node examples/remaining-coverage.ts",
    "example:sde-basic": "ts-node examples/sde-basic-lookup.ts",
    "example:sde-fitting": "ts-node examples/sde-fitting.ts",
    "example:sde-industry": "ts-node examples/sde-industry.ts",
    "example:sde-market-tree": "ts-node examples/sde-market-tree.ts",
    "sde:ingest": "ts-node scripts/sde/sde-ingest.ts",
    "sde:drift": "ts-node scripts/sde/sde-drift.ts",
    "example:write-ops": "ts-node examples/write-operations.ts",
    "token:create": "ts-node scripts/auth/create-token.ts",
    "token:refresh": "ts-node scripts/auth/refresh-token.ts",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "lint:bdd-seam": "eslint --config config/eslint/bdd-seam.config.mjs tests/bdd",
    "lint:determinism": "ts-node scripts/quality/determinism-lint.ts",
    "lint:layers": "eslint --config config/eslint/layers.config.mjs --no-inline-config src",
    "lint:suite-health": "eslint --config config/eslint/suite-health.config.mjs tests",
    "lint:workflows": "ts-node scripts/quality/workflow-lint.ts",
    "lint:package": "ts-node scripts/package/package-lint.ts",
    "size": "size-limit",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "jest --config config/jest/unit.config.cjs",
    "test:watch": "jest --config config/jest/unit.config.cjs --watch",
    "bdd": "jest --config config/jest/unit.config.cjs --testPathPatterns=tests/bdd/",
    "bdd:steps": "jest --config config/jest/unit.config.cjs --testPathPatterns=step-library",
    "bdd:alliance": "jest --config config/jest/unit.config.cjs --testPathPatterns=specs/core/0001-alliance",
    "bdd:assets": "jest --config config/jest/unit.config.cjs --testPathPatterns=step-definitions/core/assets",
    "bdd:calendar": "jest --config config/jest/unit.config.cjs --testPathPatterns=step-definitions/core/calendar",
    "bdd:character": "jest --config config/jest/unit.config.cjs --testPathPatterns=step-definitions/core/character",
    "bdd:clones": "jest --config config/jest/unit.config.cjs --testPathPatterns=specs/core/0007-clones",
    "bdd:contacts": "jest --config config/jest/unit.config.cjs --testPathPatterns=step-definitions/core/contacts",
    "bdd:contracts": "jest --config config/jest/unit.config.cjs --testPathPatterns=step-definitions/core/contracts",
    "bdd:corporation": "jest --config config/jest/unit.config.cjs --testPathPatterns=step-definitions/core/corporation",
    "bdd:corporation-projects": "jest --config config/jest/unit.config.cjs --testPathPatterns=specs/core/0004-corporation-projects",
